{
  "name": "qimen-shisan-gong",
  "version": "1.0.0",
  "description": "十三宫奇门遁甲排盘 APP",
  "main": "algorithm/qimen.js",
  "scripts": {
    "test": "node algorithm/qimen.js",
    "test:school": "node --test tests/school-library.test.js tests/school-reader.test.js tests/school-integration.test.js tests/paipan-render.test.js",
    "download:school": "node scripts/download-school-books.js",
    "build:browser": "esbuild algorithm/browser-entry.js --bundle --outfile=public/algorithm.bundle.js --format=iife --global-name=QiMenAlgorithmBundle",
    "build:android": "npm run build:browser && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:android:win": "npm run build:browser && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "gen:cases": "node algorithm/generate-cases.js",
    "test:regression": "node algorithm/regression-test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "bcryptjs": "^3.0.3",
    "epubjs": "^0.3.93",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lunar-javascript": "^1.6.11",
    "pdf-parse": "^2.4.5",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
